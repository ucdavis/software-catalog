{
  "name": "software-catalog",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "db:up": "docker compose -p software-catalog_devcontainer -f .devcontainer/docker-compose.yml up -d sql",
    "db:down": "docker compose -p software-catalog_devcontainer -f .devcontainer/docker-compose.yml stop sql",
    "db:logs": "docker compose -p software-catalog_devcontainer -f .devcontainer/docker-compose.yml logs -f sql",
    "deployment-settings:sync": "node scripts/sync-deployment-settings.mts --write",
    "deployment-settings:check": "npm run deployment-settings:typecheck && node scripts/sync-deployment-settings.mts --check",
    "deployment-settings:typecheck": "tsc -p tsconfig.scripts.json --noEmit",
    "start": "npm-run-all --parallel start:server start:client:when-server-ready",
    "start:server": "dotnet watch run --project server/server.csproj --launch-profile http-cli",
    "start:client": "cd client && npm run dev:open",
    "start:client:debug": "wait-on http-get://127.0.0.1:5165/health && cd client && npm run dev",
    "start:client:when-server-ready": "wait-on http-get://127.0.0.1:5165/health && npm run start:client",
    "test:tooling": "node --test scripts/scan-secrets.test.mts scripts/dependabot-policy.test.mts",
    "review": "npm run review:base -- --base origin/main",
    "review:base": "coderabbit review --agent --include-untracked --config AGENTS.md .coderabbit.yaml",
    "review:uncommitted": "coderabbit review --agent --include-untracked --uncommitted --config AGENTS.md .coderabbit.yaml",
    "security": "npm run security:dependencies && npm run security:workflows && npm run security:secrets",
    "security:dependencies": "npm run security:npm && npm run security:nuget",
    "security:npm": "npm audit && npm audit --prefix client",
    "security:nuget": "dotnet restore app.sln --force --no-http-cache -p:AuditPipeline=true && dotnet restore tests/server.sqltests/server.sqltests.csproj --force --no-http-cache -p:AuditPipeline=true",
    "security:workflows": "actionlint && zizmor --offline --strict-collection --persona regular .github",
    "security:secrets": "node scripts/scan-secrets.mts",
    "security:history": "gitleaks git --redact --no-banner --log-opts=--all .",
    "restore": "npm ci && npm ci --prefix client && dotnet restore app.sln",
    "build": "npm run build:client && npm run build:server",
    "build:client": "npm run build --prefix client",
    "build:server": "dotnet build app.sln --configuration Release --no-restore --warnaserror",
    "build:server:clean": "npm run build:server -- --no-incremental",
    "lint": "npm run lint --prefix client && npm run deployment-settings:check",
    "check": "npm run lint && npm run build && npm run test:client && npm run test:server:built && npm run test:tooling",
    "check:clean": "npm run lint && npm run build:client && npm run build:server:clean && npm run test:client && npm run test:server:built && npm run test:tooling",
    "test": "npm run test:client && npm run test:server && npm run test:tooling",
    "test:client": "npm test --prefix client -- --run",
    "test:server": "dotnet test app.sln --configuration Release --no-restore",
    "test:server:built": "dotnet test app.sln --configuration Release --no-build",
    "test:sql": "dotnet test tests/server.sqltests/server.sqltests.csproj --configuration Release",
    "publish": "dotnet publish server/server.csproj --configuration Release",
    "publish:built": "dotnet publish server/server.csproj --configuration Release --no-build --no-restore -p:BuildClientAssets=false",
    "test:browser": "playwright test",
    "publish:smoke": "npm run publish:built -- --output artifacts/smoke",
    "security:workflows:all": "npm run security:workflows",
    "ci": "npm run check:clean && npm run security",
    "format:server:check": "dotnet format whitespace . --folder --verify-no-changes --include",
    "format:server": "dotnet format whitespace . --folder --include",
    "format:typescript:check": "npm exec --prefix client --no -- prettier --config client/prettier.config.js --check",
    "format:typescript": "npm exec --prefix client --no -- prettier --config client/prettier.config.js --write"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^24.3.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.2",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "@ucdavis/gunrock-tailwind": "^2.6.2"
  }
}
